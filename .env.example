# Neon Postgres. Use the pooled host for the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Optional direct (non-pooler) Neon connection used by npm run db:setup.
DATABASE_URL_UNPOOLED=""

# Gmail SMTP credentials for application email (use a Google App Password).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional Gmail backups; use one unique account per numbered pair.
GMAIL_BACKUP_1_USER=""
GMAIL_BACKUP_1_APP_PASSWORD=""
GMAIL_BACKUP_2_USER=""
GMAIL_BACKUP_2_APP_PASSWORD=""
# Conservative per-account rolling 24-hour send cap (maximum 500).
GMAIL_DAILY_LIMIT="450"
# Optional sender alias configured in Gmail.
MAIL_FROM=""

# Public app origin used for scheduled donor response links.
# VERCEL_URL is used automatically on Vercel; set this explicitly elsewhere.
PUBLIC_APP_URL=""

# Protects HEAD/GET /api/process-email-outbox and HEAD/GET /api/process-certificates.
# CRON_SECRET=""
# Required to protect POST /api/contact/export.
# FEEDBACK_EXPORT_SECRET=""

# Optional. Dev defaults to 5173; preview/start default to 4173.
# PORT=""
# NODE_ENV="production"
