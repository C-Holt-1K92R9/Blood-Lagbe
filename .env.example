# Neon Postgres. Use the pooled host for the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Gmail SMTP credentials for application email (use a Google App Password).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional sender alias configured in Gmail.
MAIL_FROM=""

# Required by the Vercel scheduled cleanup of old emergency board posts.
# CRON_SECRET=""
# Required to protect POST /api/contact/export.
# FEEDBACK_EXPORT_SECRET=""

# Optional. Dev defaults to 5173; preview/start default to 4173.
# PORT=""
# NODE_ENV="production"
